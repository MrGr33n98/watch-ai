# Local development values only. Replace passwords/keys before starting the stack.
APP_ENV=development
API_PORT=8000
POSTGRES_PORT=15432
POSTGRES_DB=watch_ai
POSTGRES_USER=watch_ai
POSTGRES_PASSWORD=replace-with-a-random-local-password
DATABASE_URL=postgresql+psycopg://watch_ai:replace-with-a-random-local-password@db:5432/watch_ai
# Optional operator console & remote device revocation secret (>= 32 bytes). Leave blank to disable /v1/admin/* and /phone.
ADMIN_API_KEY=
# Server-side provider configuration. Use VISION_PROVIDER=fake only in development/test without OpenRouter credentials.
VISION_PROVIDER=fake
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Required as an approved positive amount before enabling real model calls.
MONTHLY_MODEL_BUDGET_USD=
OUTBOX_POLL_INTERVAL_SECONDS=1.0
ENABLE_EMBEDDED_WORKER=false
# WAHA stays disabled until isolated QA credentials and session/sender allowlists are set.
ENABLE_WAHA_INGEST=false
WAHA_SEND_REPLIES=false
WAHA_BASE_URL=
WAHA_API_KEY=
WAHA_WEBHOOK_HMAC_SECRET=
WAHA_SENDER_HASH_SECRET=
WAHA_ALLOWED_SESSIONS=
WAHA_ALLOWED_SENDERS=
# Map each authorized WAHA sender to a pre-provisioned users.id UUID: sender=UUID.
WAHA_SENDER_USER_IDS=
WAHA_DEFAULT_QUESTION_COUNT=4
WAHA_BATCH_EXPIRY_SECONDS=3600
WATCH_AI_MEDIA_DIR=/app/private-media
WATCH_AI_RENDER_DIR=/app/private-renders
# Proposed expiry periods; approve the privacy policy before scheduling the purge command.
MEDIA_RETENTION_HOURS=24
SESSION_RETENTION_DAYS=30
# Public HTTPS domain used when enabling the optional `tls` Caddy profile.
WATCH_AI_DOMAIN=watch-ai.example.test
